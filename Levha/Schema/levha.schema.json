{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "levha.schema.json",
  "title": "LEVHA paketi (şema v1)",
  "description": "Bir paket = bir alt konu = bir .json dosyası. Yapısal kurallar (ızgara içinde/çakışmasız konum, referans bütünlüğü, etiket ≤ 28 karakter, düğüm sayıları) levha-lint ile denetlenir.",
  "type": "object",
  "required": ["sema_surumu", "paket_id", "ders", "bolum", "alt_konu", "levhalar"],
  "properties": {
    "sema_surumu": { "const": 1 },
    "paket_id": { "type": "string", "minLength": 1, "examples": ["ped.neo.sarilik"] },
    "ders": { "type": "string", "minLength": 1 },
    "bolum": { "type": "string", "minLength": 1 },
    "alt_konu": { "type": "string", "minLength": 1 },
    "levhalar": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/levha" } },
    "sorular": { "type": "array", "items": { "$ref": "#/$defs/soru" } }
  },
  "$defs": {
    "renk": { "enum": ["kirmizi", "mavi", "yesil", "sari", "gri"] },
    "sekil": { "enum": ["durum", "karar", "surec"] },
    "etiket": { "type": "string", "minLength": 1, "maxLength": 28 },

    "levha": {
      "type": "object",
      "required": ["id", "tip", "baslik", "akilda_kalan"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tip": { "enum": ["algoritma", "matris", "sayi_cetveli", "zaman_cizelgesi", "yolak", "agac", "vucut_haritasi"] },
        "baslik": { "type": "string" },
        "akilda_kalan": { "type": "string" },
        "duzen": {
          "type": "object",
          "required": ["izgara"],
          "properties": {
            "izgara": {
              "description": "[sütun sayısı (2–4), satır sayısı (2–6)]",
              "type": "array", "prefixItems": [
                { "type": "integer", "minimum": 2, "maximum": 4 },
                { "type": "integer", "minimum": 2, "maximum": 6 }
              ], "minItems": 2, "maxItems": 2
            },
            "sabit": { "type": "boolean" }
          }
        },
        "dugumler": { "type": "array", "items": { "$ref": "#/$defs/dugum" } },
        "baglantilar": { "type": "array", "items": { "$ref": "#/$defs/baglanti" } },
        "ortme_sirasi": {
          "description": "Örtme modunda gizlenecek düğümler, öncelik sırasıyla; ilk 3'ü varsayılan maske. Matris hücreleri r{satır}c{sütun}.",
          "type": "array", "items": { "type": "string" }
        },
        "sabotajlar": {
          "description": "Part 2'de yorumlanır; şimdilik ham saklanır.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tip"],
            "properties": {
              "tip": { "type": "string" },
              "hedef": { "type": "array", "items": { "type": "string" } },
              "dogrusu": { "type": "string" }
            }
          }
        },
        "satirlar": { "type": "array", "items": { "type": "string" } },
        "sutunlar": { "type": "array", "items": { "type": "string" } },
        "hucreler": {
          "description": "satirlar.count × sutunlar.count; hücre id'si r{satır}c{sütun} (0 tabanlı).",
          "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/hucre" } }
        },
        "eksen": {
          "type": "object",
          "required": ["min", "max", "birim"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "birim": { "type": "string" } }
        },
        "isaretler": { "type": "array", "items": { "$ref": "#/$defs/isaret" } }
      },
      "allOf": [
        { "if": { "properties": { "tip": { "const": "algoritma" } } },
          "then": { "required": ["duzen", "dugumler"], "properties": { "dugumler": { "minItems": 6, "maxItems": 20 } } } },
        { "if": { "properties": { "tip": { "const": "matris" } } },
          "then": { "required": ["satirlar", "sutunlar", "hucreler"] } },
        { "if": { "properties": { "tip": { "const": "sayi_cetveli" } } },
          "then": { "required": ["eksen", "isaretler"], "properties": { "isaretler": { "minItems": 6, "maxItems": 20 } } } }
      ]
    },

    "dugum": {
      "type": "object",
      "required": ["id", "etiket"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "etiket": { "$ref": "#/$defs/etiket" },
        "sekil": { "$ref": "#/$defs/sekil", "default": "durum" },
        "renk": { "$ref": "#/$defs/renk", "default": "gri" },
        "konum": {
          "description": "[sütun, satır], 0 tabanlı; algoritmada zorunlu.",
          "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2
        },
        "tus": { "type": "boolean", "default": false, "description": "TUS'un sevdiği düğüm: 3 px kenarlık." },
        "not": { "type": "string", "description": "2–4 cümle; düğüme dokununca açılır." }
      }
    },

    "baglanti": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "etiket": { "type": "string" }
      }
    },

    "hucre": {
      "type": "object",
      "required": ["metin"],
      "properties": {
        "metin": { "$ref": "#/$defs/etiket" },
        "renk": { "$ref": "#/$defs/renk", "default": "gri" },
        "tus": { "type": "boolean", "default": false },
        "not": { "type": "string" }
      }
    },

    "isaret": {
      "type": "object",
      "required": ["id", "etiket"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "deger": {
          "type": "number",
          "description": "Eksen aralığında olmalı. Boş bırakılırsa işaret sabit bir sayıya bağlanmaz; 'nomograma bağlı' şeridinde çizilir."
        },
        "etiket": { "$ref": "#/$defs/etiket" },
        "renk": { "$ref": "#/$defs/renk", "default": "gri" },
        "tus": { "type": "boolean", "default": false },
        "not": { "type": "string" }
      }
    },

    "soru": {
      "type": "object",
      "required": ["id", "levha", "kok", "secenekler", "dogru", "aciklama"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "levha": { "type": "string", "description": "Bu paketteki bir levhanın id'si." },
        "dugumler": { "type": "array", "items": { "type": "string" } },
        "kok": { "type": "string", "minLength": 1 },
        "secenekler": { "type": "array", "items": { "type": "string" }, "minItems": 5, "maxItems": 5 },
        "dogru": { "type": "integer", "minimum": 0, "maximum": 4 },
        "aciklama": { "type": "string" },
        "aciklama_yolu": { "type": "array", "items": { "type": "string" } },
        "celdirici_dugum": {
          "description": "{\"seçenek indeksi\": \"düğüm id\"} — çeldiriciyi açıklayan düğüm.",
          "type": "object",
          "propertyNames": { "pattern": "^[0-4]$" },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
