{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "levha.schema.json",
  "title": "LEVHA paketi (şema v5)",
  "description": "Bir paket = bir alt konu = bir .json dosyası. Yapısal kurallar (ızgara içinde/çakışmasız konum, referans bütünlüğü, etiket ≤ 28 karakter, düğüm sayıları, anlatımdaki [[...]] referansları) levha-lint ile denetlenir. \"tur\": \"soru_paketi\" olan dosya levhasız soru paketidir. Sürüm 1–4 paketler okunmaya devam eder.",
  "type": "object",
  "required": [
    "paket_id",
    "ders",
    "bolum",
    "alt_konu"
  ],
  "properties": {
    "sema_surumu": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "tur": {
      "enum": [
        "soru_paketi"
      ],
      "description": "v5: yoksa konu paketi; \"soru_paketi\" → yalnız sorular (levhalar yazılmaz)."
    },
    "paket_id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "ped.neo.sarilik"
      ]
    },
    "ders": {
      "type": "string",
      "minLength": 1
    },
    "bolum": {
      "type": "string",
      "minLength": 1
    },
    "alt_konu": {
      "type": "string",
      "minLength": 1
    },
    "levhalar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/levha"
      }
    },
    "sorular": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/soru"
      }
    },
    "kazanimlar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kazanim"
      }
    },
    "aileler": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aile"
      }
    },
    "anlatim": {
      "type": "string",
      "description": "v5: konu anlatımı (markdown, 2.000–6.000 kelime; ## başlıklar, **kalın** terimler, tablolar). [[n2]] paketteki düğüm, [[levha_id]] levha (tam ya da paket içi kısa id), [[levha_id#n2]] belirli levhanın düğümü; [[ref|görünen metin]] görünen metni değiştirir."
    }
  },
  "$defs": {
    "renk": {
      "enum": [
        "kirmizi",
        "mavi",
        "yesil",
        "sari",
        "gri"
      ]
    },
    "sekil": {
      "enum": [
        "durum",
        "karar",
        "surec",
        "madde"
      ],
      "description": "madde = dikdörtgen (yolak), surec = yuvarlak (enzim/ilaç), karar = KARAR etiketli"
    },
    "etiket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28
    },
    "levha": {
      "type": "object",
      "required": [
        "id",
        "tip",
        "baslik",
        "akilda_kalan"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tip": {
          "enum": [
            "algoritma",
            "matris",
            "sayi_cetveli",
            "zaman_cizelgesi",
            "yolak",
            "agac",
            "vucut_haritasi"
          ]
        },
        "baslik": {
          "type": "string"
        },
        "akilda_kalan": {
          "type": "string"
        },
        "duzen": {
          "type": "object",
          "required": [
            "izgara"
          ],
          "properties": {
            "izgara": {
              "description": "[sütun sayısı (2–4), satır sayısı (2–6)]",
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 4
                },
                {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 6
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "sabit": {
              "type": "boolean"
            }
          }
        },
        "dugumler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dugum"
          }
        },
        "baglantilar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baglanti"
          }
        },
        "ortme_sirasi": {
          "description": "Örtme modunda gizlenecek düğümler, öncelik sırasıyla; ilk 3'ü varsayılan maske. Matris hücreleri r{satır}c{sütun}.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sabotajlar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sabotaj"
          },
          "description": "Yazılmış sabotajlar; yoksa uygulama tip bazlı üretir."
        },
        "satirlar": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sutunlar": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hucreler": {
          "description": "satirlar.count × sutunlar.count; hücre id'si r{satır}c{sütun} (0 tabanlı).",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hucre"
            }
          }
        },
        "eksen": {
          "type": "object",
          "required": [
            "min",
            "max",
            "birim"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "birim": {
              "type": "string",
              "description": "zaman_cizelgesi için gun | hafta | ay | yil"
            }
          }
        },
        "isaretler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/isaret"
          }
        },
        "seritler": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "ad"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "ad": {
                "type": "string"
              }
            }
          }
        },
        "olaylar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/olay"
          }
        },
        "bolgeler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bolgeIsareti"
          }
        },
        "insa_sirasi": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "İnşa'da boş bırakılacak düğümler (yoksa ortme_sirasi)."
        },
        "kaynak": {
          "type": "object",
          "properties": {
            "kitap": {
              "type": "string"
            },
            "sayfa": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "baski": {
              "type": "string",
              "description": "v4: kitabın baskısı, ör. \"2024\"."
            },
            "anahtar_kelimeler": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 4,
              "maxItems": 6,
              "description": "v4: kitap sayfası eşlemesinde ×3 ağırlıklı kelimeler."
            }
          }
        },
        "revizyon": {
          "type": "integer",
          "minimum": 0,
          "description": "v4: paket güncellemesiyle artar. Depodakinden büyükse paketteki düzen yerel düzenin önüne geçer."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tip": {
                "const": "algoritma"
              }
            }
          },
          "then": {
            "required": [
              "duzen",
              "dugumler"
            ],
            "properties": {
              "dugumler": {
                "minItems": 6,
                "maxItems": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tip": {
                "const": "matris"
              }
            }
          },
          "then": {
            "required": [
              "satirlar",
              "sutunlar",
              "hucreler"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tip": {
                "const": "sayi_cetveli"
              }
            }
          },
          "then": {
            "required": [
              "eksen",
              "isaretler"
            ],
            "properties": {
              "isaretler": {
                "minItems": 6,
                "maxItems": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tip": {
                "enum": [
                  "yolak",
                  "agac"
                ]
              }
            }
          },
          "then": {
            "required": [
              "duzen",
              "dugumler"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tip": {
                "const": "zaman_cizelgesi"
              }
            }
          },
          "then": {
            "required": [
              "eksen",
              "seritler",
              "olaylar"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tip": {
                "const": "vucut_haritasi"
              }
            }
          },
          "then": {
            "required": [
              "bolgeler"
            ]
          }
        }
      ]
    },
    "dugum": {
      "type": "object",
      "required": [
        "id",
        "etiket"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "etiket": {
          "$ref": "#/$defs/etiket"
        },
        "sekil": {
          "$ref": "#/$defs/sekil",
          "default": "durum"
        },
        "renk": {
          "$ref": "#/$defs/renk",
          "default": "gri"
        },
        "konum": {
          "description": "[sütun, satır], 0 tabanlı; algoritmada zorunlu.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tus": {
          "type": "boolean",
          "default": false,
          "description": "TUS'un sevdiği düğüm: 3 px kenarlık."
        },
        "not": {
          "type": "string",
          "description": "2–4 cümle; düğüme dokununca açılır."
        },
        "ebeveyn": {
          "type": "string",
          "description": "ağaç: bağlantı verilmezse kenar bu alandan çizilir"
        }
      }
    },
    "baglanti": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "etiket": {
          "type": "string"
        },
        "tip": {
          "enum": [
            "normal",
            "inhibe",
            "uyarir",
            "olasi"
          ],
          "default": "normal",
          "description": "normal: ok · inhibe: uçta ⊣ · uyarir: ok + '+' rozeti · olasi: kesikli çizgi"
        }
      }
    },
    "hucre": {
      "type": "object",
      "required": [
        "metin"
      ],
      "properties": {
        "metin": {
          "$ref": "#/$defs/etiket"
        },
        "renk": {
          "$ref": "#/$defs/renk",
          "default": "gri"
        },
        "tus": {
          "type": "boolean",
          "default": false
        },
        "not": {
          "type": "string"
        }
      }
    },
    "isaret": {
      "type": "object",
      "required": [
        "id",
        "etiket"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deger": {
          "type": "number",
          "description": "Eksen aralığında olmalı. Boş bırakılırsa işaret sabit bir sayıya bağlanmaz; 'nomograma bağlı' şeridinde çizilir."
        },
        "etiket": {
          "$ref": "#/$defs/etiket"
        },
        "renk": {
          "$ref": "#/$defs/renk",
          "default": "gri"
        },
        "tus": {
          "type": "boolean",
          "default": false
        },
        "not": {
          "type": "string"
        }
      }
    },
    "soru": {
      "type": "object",
      "required": [
        "id",
        "kok",
        "secenekler",
        "dogru",
        "aciklama"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "levha": {
          "type": "string",
          "description": "Konu paketinde zorunlu: bu paketteki bir levhanın id'si. Soru paketinde isteğe bağlı: başka paketin levhası (tam id, ör. ped.neo.sarilik.algoritma); yoksa soru bağımsızdır ve düğüm alanı taşımaz."
        },
        "dugumler": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kok": {
          "type": "string",
          "minLength": 1
        },
        "secenekler": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "dogru": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "aciklama": {
          "type": "string"
        },
        "aciklama_yolu": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "celdirici_dugum": {
          "description": "{\"seçenek indeksi\": \"düğüm id\"} — çeldiriciyi açıklayan düğüm.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-4]$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "kazanim": {
          "type": "string",
          "description": "v3'te zorunlu."
        },
        "kalip": {
          "$ref": "#/$defs/kalip"
        },
        "zorluk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "secenek_aile": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-4]$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Şık indeksi → aile üyesi (doğru şık dahil); karıştırma matrisi bundan kurulur."
        },
        "ipucu_sirasi": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ipucu"
          },
          "description": "v4: belirleyicilik sırasıyla ipuçları; İpucu avı kartları kökteki sırayla gösterir."
        },
        "kirilimlar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kirilim"
          }
        },
        "anlatim_baslik": {
          "type": "string",
          "description": "v5: anlatımdaki bir ## başlığı; cevaptan sonra \"Anlatımda oku\" o başlığa gider."
        }
      }
    },
    "bolge": {
      "enum": [
        "bas",
        "yuz",
        "goz",
        "kulak",
        "agiz",
        "boyun",
        "gogus",
        "kalp",
        "karin",
        "karaciger",
        "dalak",
        "bobrek",
        "genital",
        "kol",
        "el",
        "bacak",
        "ayak",
        "deri",
        "eklem",
        "omurga"
      ]
    },
    "olay": {
      "type": "object",
      "required": [
        "id",
        "serit",
        "bas",
        "etiket"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "serit": {
          "type": "string"
        },
        "bas": {
          "type": "number"
        },
        "bit": {
          "type": [
            "number",
            "null"
          ],
          "description": "Doluysa aralık çubuğu, boşsa nokta işareti."
        },
        "etiket": {
          "$ref": "#/$defs/etiket"
        },
        "renk": {
          "$ref": "#/$defs/renk"
        },
        "tus": {
          "type": "boolean"
        },
        "not": {
          "type": "string"
        }
      }
    },
    "bolgeIsareti": {
      "type": "object",
      "required": [
        "id",
        "bolge",
        "etiket"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bolge": {
          "$ref": "#/$defs/bolge"
        },
        "etiket": {
          "$ref": "#/$defs/etiket"
        },
        "renk": {
          "$ref": "#/$defs/renk"
        },
        "tus": {
          "type": "boolean"
        },
        "not": {
          "type": "string"
        }
      }
    },
    "sabotaj": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu"
          ],
          "properties": {
            "tip": {
              "const": "etiket_takas"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu",
            "yanlis_deger"
          ],
          "properties": {
            "tip": {
              "const": "deger_kaydir"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            },
            "yanlis_deger": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu",
            "yanlis_renk"
          ],
          "properties": {
            "tip": {
              "const": "renk_degistir"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            },
            "yanlis_renk": {
              "$ref": "#/$defs/renk"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu"
          ],
          "properties": {
            "tip": {
              "const": "baglanti_ters"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu"
          ],
          "properties": {
            "tip": {
              "const": "hucre_takas"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu"
          ],
          "properties": {
            "tip": {
              "const": "sira_boz"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tip",
            "hedef",
            "dogrusu",
            "yanlis_bolge"
          ],
          "properties": {
            "tip": {
              "const": "bolge_kaydir"
            },
            "hedef": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "dogrusu": {
              "type": "string",
              "description": "Tek cümle; hata bulununca gösterilir."
            },
            "yanlis_bolge": {
              "$ref": "#/$defs/bolge"
            }
          }
        }
      ]
    },
    "kalip": {
      "enum": [
        "en_sik",
        "ilk_adim",
        "en_olasi_tani",
        "mekanizma",
        "istisna",
        "esik_sayi",
        "ayirici_cift",
        "kesin_tani",
        "patognomonik",
        "yas_sira",
        "ilac",
        "esleme"
      ]
    },
    "kazanim": {
      "type": "object",
      "required": [
        "id",
        "metin",
        "kalip",
        "sorulabilirlik"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metin": {
          "type": "string",
          "minLength": 1
        },
        "kalip": {
          "$ref": "#/$defs/kalip"
        },
        "dugumler": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paketin herhangi bir levhasındaki düğümler."
        },
        "sorulabilirlik": {
          "type": "integer",
          "minimum": 1,
